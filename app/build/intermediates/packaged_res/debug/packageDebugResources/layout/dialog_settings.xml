<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Configuración y Preferencias"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Personaliza tus recordatorios, alarmas, ubicación y cumpleaños"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- INTERRUPTOR GENERAL -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/primary_container"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMaster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:padding="16dp"
                android:text="🔔 Activar todas las alarmas"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN 1: HIDRATACIÓN AGUA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="💧 Recordatorio de Hidratación (Agua)"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swWater"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Avisar para tomar agua"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spWaterInterval"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- SECCIÓN 2: MOVIMIENTO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="🚶 Recordatorio de Movimiento / Estiramiento"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swMovement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Avisar para moverte"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spMovementInterval"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- SECCIÓN 3: DESCANSO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="😴 Recordatorio de Pausa y Descanso"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swRest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Avisar para descansar"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spRestInterval"
                android:layout_width="wrap_content"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- SECCIÓN 4: COMPARTIR UBICACIÓN CON LA FAMILIA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="📍 Privacidad y Ubicación GPS"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/call_blue_container"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#90CAF9"
            app:strokeWidth="1dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/swShareLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:padding="16dp"
                android:text="📍 Compartir ubicación en tiempo real"
                android:textColor="@color/call_blue"
                android:textSize="15sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- SECCIÓN 5: CUMPLEAÑOS Y RECORDATORIOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="🎂 Fecha de Cumpleaños"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSetBirthday"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="📅 Configurar Fecha de Cumpleaños"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/primary" />

    </LinearLayout>
</ScrollView>
